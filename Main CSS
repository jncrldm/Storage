:root {
  --hp:            #E86A91;  /* header + footer pink */
  --accent:        #bd2e5c;  /* nav links, cart button, active tab */
  --accent-dark:   #9e234b;  /* cart button hover */
  --accent-select: #993055;  /* selected nav link */
  --accent-hover:  #db3469;  /* nav link hover */
  --heading:       #a92755;  /* section/menu titles, tab text */
  --text-pink:     #b52e5b;  /* body text, food name/price */
  --tab-bg:        #f9cbd8;
  --text-dark:     #4a2c36;
  --line:          rgba(255, 255, 255, 0.45);  /* footer divider lines */
  --font-main:  'Poppins', sans-serif;
  --font-title: "Timmana", sans-serif;
  --font-serif: "Jaini", serif;

  --arrow-offset: -20px;   /* negative = further OUTSIDE the row */
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

body {
  background-color: #fff5f5;
  font-family: Arial, sans-serif;
  color: var(--text-pink);
}

main {
  flex: 1;
}

h1, h2, h3 {
  font-family: var(--font-main);
}


/* ============================== HEADER ============================== */
.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  background-color: var(--hp);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.26);
}

.logo {
  height: 60px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
  height: 30px;
  list-style: none;
  font-family: var(--font-title);
}

.nav-links img {
  display: block;
  position: relative;
  top: -4px;
}

.nav-links a {
  display: inline-flex;
  align-items: center;
  height: 52px;
  padding: 10px 20px 0;
  background-color: var(--accent);
  color: #fff;
  font-size: 16px;
  text-decoration: none;
  border-radius: 15px;
  border-bottom: 4px solid var(--text-dark);
}

a.Selected {
  background-color: var(--accent-select);
  border-bottom: 0;
  box-shadow: 0 10px 10px rgba(20, 3, 5, 0.26);
  color: #000;
}

.nav-links a:hover {
  background-color: var(--accent-hover);
  border-bottom-color: color-mix(in srgb, var(--text-dark) 50%, transparent);
  border-radius: 20px;
  padding: 10px 20px;
  font-size: 18px;
  font-weight: bold;
  box-shadow: none;
}


/* ============================== FOOTER ============================== */

.footer {
  background: var(--hp);
  color: #fff;
  padding: 28px 5% 12px;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.4fr 1.2fr 1.2fr 1.5fr;
  align-items: start;
}

.footer-logo img {
  width: 190px;
  height: auto;
  display: block;
  filter: brightness(0) invert(1);  /* makes the pink logo appear white */
}

.footer-column {
  min-height: 80px;
  border-left: 1px solid var(--line);
  padding-left: 35px;
}

.footer-column h3 {
  font-size: 15px;
  margin-bottom: 8px;
}

.footer-column a {
  display: block;
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  line-height: 19px;
  transition: 0.2s;
}

.footer-column a:hover {
  opacity: 0.7;
}

.social-icons {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 10px;
}

.social-link img {
  width: 28px;
  height: 28px;
  object-fit: contain;
  display: block;
}

.contact-column p {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
  font-size: 12px;
}

.icon {
  width: 18px;
  font-size: 15px;
  text-align: center;
}

.footer-bottom {
  max-width: 1200px;
  margin: 15px auto 0;
  padding-top: 12px;
  border-top: 1px solid var(--line);
  text-align: center;
}

.footer-bottom p {
  font-size: 11px;
}

.heart {
  font-size: 16px;
  margin-left: 5px;
}


/* ============================ MAIN CONTENT =========================== */

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 30px;
}

.section-title,
.menu-title {
  font-size: 65px;
  font-weight: bold;
  color: var(--heading);
}

.section-title {
  font-family: var(--font-title);
  margin: 0 0 20px 20px;
}

.menu-title {
  font-family: var(--font-serif);
}


/* ============================== CAROUSEL ============================= */

.carousel {
  position: relative;
  anchor-scope: --food-row;      /* each carousel gets its own anchor */
  timeline-scope: --row-scroll;  /* ...and its own scroll timeline */
}

/* edge fades */
.carousel::before,
.carousel::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 10%;
  pointer-events: none;
  z-index: 1;
}

.carousel::before {
  left: 0;
  background: linear-gradient(to left, transparent, #fff5f5);
  opacity: 0;   /* hidden until you scroll */
}

.carousel::after {
  right: 0;
  background: linear-gradient(to right, transparent, #fff5f5);
}

@keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }
@keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }

@supports (animation-timeline: scroll()) {
  .carousel::before {
    animation: fade-in linear both;
    animation-timeline: --row-scroll;
    animation-range: 0px 150px;
  }

  .carousel::after {
    animation: fade-out linear both;
    animation-timeline: --row-scroll;
    animation-range: calc(100% - 150px) 100%;
  }
}

/* native scroll buttons (Chrome 135+) */
.carousel .food-row::scroll-button(*) {
  position: fixed;
  position-anchor: --food-row;
  top: anchor(center);
  translate: 0 -50%;
  z-index: 2;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  transition: 0.2s;
}

.carousel .food-row::scroll-button(left) {
  content: "\276E" / "Scroll left";
  left: calc(anchor(left) + var(--arrow-offset));
}

.carousel .food-row::scroll-button(right) {
  content: "\276F" / "Scroll right";
  right: calc(anchor(right) + var(--arrow-offset));
}

.carousel .food-row::scroll-button(*):hover:not(:disabled) {
  background-color: var(--accent-dark);
}

.carousel .food-row::scroll-button(*):disabled {
  opacity: 0.35;
  cursor: default;
}

.food-row {
  display: flex;
  gap: 25px;
  margin-bottom: 35px;
  padding: 4px 0 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  anchor-name: --food-row;
  scroll-timeline: --row-scroll x;
  scrollbar-width: auto;
  scrollbar-color: var(--accent) var(--tab-bg);
  overscroll-behavior-x: contain;
}

.food-card {
  flex: 0 0 calc((100% - 75px) / 3.35);   /* 3 cards + a peek of the 4th */
  scroll-snap-align: start;
  padding: 10px;
  background-color: #fff;
  border-radius: 15px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.food-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 25px;
  display: block;
}

/* Fallback arrows (anchor links) for browsers without ::scroll-button */
.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  transition: 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.arrow:hover { background-color: var(--accent-dark); }
.arrow-left  { left: -32px; }
.arrow-right { right: -32px; }

#today-first,
#today-last,
#menu-first,
#menu-last {
  scroll-margin-top: 150px;   /* only matters for the fallback arrows */
}

/* hide the fallback arrows when native buttons exist (block is closed right away) */
@supports selector(::scroll-button(left)) {
  .arrow { display: none; }
}


/* ====================== "SELECT MORE" CARD + POP-UP ================== */

.more-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 220px;
  font: inherit;
  cursor: pointer;
  text-decoration: none;
  color: var(--heading);
  background-color: var(--tab-bg);
  border: 2px dashed var(--accent);
  transition: 0.2s;
}

.more-icon {
  display: grid;
  place-items: center;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 22px;
}

.more-text {
  font-size: 18px;
  font-weight: bold;
}

.more-card:hover {
  background-color: var(--accent);
  color: #fff;
}

.more-card:hover .more-icon {
  background-color: #fff;
  color: var(--accent);
}

.more-popup {
  margin: auto;                    /* centers it on screen */
  min-width: 80vw;                 /* at least 80% of the screen width */
  min-height: 80vh;                /* at least 80% of the screen height */
  max-width: 90vw;
  max-height: 90vh;
  overflow-y: auto;                /* long content scrolls inside the pop-up */
  padding: 30px;
  border: none;
  border-radius: 20px;
  background-color: #fff5f5;
  color: var(--text-pink);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.more-popup h2 {
  color: var(--heading);
  margin-bottom: 10px;
}

/* the blurred background */
.more-popup::backdrop {
  background: rgba(74, 44, 54, 0.35);
  backdrop-filter: blur(6px);
}

.popup-close {
  position: absolute;
  top: 12px;
  right: 14px;
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 22px;
  cursor: pointer;
}

.popup-close:hover {
  background-color: var(--accent-dark);
}

/* stops the page scrolling behind the pop-up */
body:has(.more-popup:popover-open) {
  overflow: hidden;
}


/* ============================ MENU / CARDS =========================== */

.food-info {
  padding: 12px 10px;
  font-size: 20px;
  color: var(--text-pink);
}

.food-name {
  font-weight: 500;
}

.price {
  margin-top: 2px;
}

.cart-btn {
  background-color: var(--accent);
  color: #fff;
  text-align: center;
  padding: 10px;
  border-radius: 10px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.2s;
}

.cart-btn:hover {
  background-color: var(--accent-dark);
}

.menu-header {
  display: flex;
  align-items: center;
  gap: 35px;
  margin: 10px 0 25px 20px;
}

.menu-tabs {
  display: flex;
  gap: 10px;
}

.tab {
  background-color: var(--tab-bg);
  color: var(--heading);
  padding: 10px 20px;
  border-radius: 15px;
  font-family: var(--font-serif);
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.tab:hover,
.tab.active {
  background-color: var(--accent);
  color: #fff;
}


/* ====================== RESPONSIVE: KEEP THESE LAST ================== */

@media (max-width: 900px) {
  .food-card { flex: 0 0 calc((100% - 50px) / 2.35); }

  .menu-header {
    margin-left: 0;
    flex-wrap: wrap;
  }
}

@media (max-width: 850px) {
  .footer-container {
    grid-template-columns: 1fr 1fr;
    row-gap: 30px;
  }

  .footer-column { padding-left: 25px; }
}

@media (max-width: 600px) {
  :root { --arrow-offset: 6px; }   /* keeps the native arrows on-screen */

  .container { padding: 15px; }

  .food-card { flex: 0 0 80%; }
  .food-card img { height: 230px; }

  .arrow { width: 36px; height: 36px; font-size: 14px; }
  .arrow-left  { left: -6px; }
  .arrow-right { right: -6px; }

  .menu-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .menu-tabs { flex-wrap: wrap; }
}

@media (max-width: 550px) {
  .footer {
    padding: 30px 25px 15px;
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .footer-logo {
    padding-bottom: 5px;
  }

  .footer-logo img {
    width: 200px;
  }

  .footer-column {
    border-left: none;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    padding: 18px 0 0;
  }

  .footer-column h3 {
    font-size: 16px;
  }

  .footer-bottom {
    margin-top: 20px;
  }
}

/* ====================== FOOD LIST INSIDE THE POP-UP ====================== */
.more-popup {
  position: fixed;
  box-sizing: border-box;
}

.more-popup .popup-description {
  margin: 0 0 22px;
  color: var(--text-pink);
  font-size: 15px;
}

.popup-food-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  padding: 4px 2px 12px;
}

.popup-food-card {
  min-width: 0;
  overflow: hidden;
  background: #fff;
  border: 1px solid #f3c6d3;
  border-radius: 14px;
  box-shadow: 0 3px 10px rgba(74, 44, 54, 0.09);
}

.popup-food-card img {
  display: block;
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.popup-food-info {
  padding: 12px 13px 8px;
}

.popup-food-info h3 {
  color: var(--heading);
  font-family: var(--font-main);
  font-size: 17px;
  line-height: 1.3;
  margin: 0 0 5px;
}

.popup-food-info p {
  color: var(--text-pink);
  font-size: 16px;
  font-weight: 600;
}

.popup-cart-btn {
  display: block;
  width: calc(100% - 26px);
  margin: 0 13px 13px;
  padding: 10px 8px;
  border: 0;
  border-radius: 9px;
  background: var(--accent);
  color: #fff;
  font: 600 13px var(--font-main);
  cursor: pointer;
  transition: background-color 0.2s, transform 0.2s;
}

.popup-cart-btn:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
}

@media (max-width: 700px) {
  .more-popup {
    min-width: 90vw;
    min-height: 70vh;
    max-width: 94vw;
    max-height: 88vh;
    padding: 24px 18px;
  }

  .popup-food-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .popup-food-card img {
    height: 125px;
  }
}

@media (max-width: 400px) {
  .popup-food-grid {
    grid-template-columns: 1fr;
  }
}



/* ====================== SEE ALL FOOD CATALOG POP-UP ====================== */
.more-popup {
  position: fixed;
  width: min(94vw, 1450px);
  min-width: 0;
  min-height: 0;
  max-width: 94vw;
  max-height: 92vh;
  padding: 30px 32px 26px;
  overflow-y: auto;
  background: #fff5f5;
  border: 1px solid #f7d5df;
  border-radius: 24px;
  color: var(--text-pink);
}

.popup-heading {
  display: grid;
  grid-template-columns: 82px minmax(260px, 1fr) minmax(220px, 320px);
  align-items: center;
  gap: 18px;
  padding: 4px 34px 22px 0;
}

.popup-brand-icon {
  width: 70px;
  height: 70px;
  display: grid;
  place-items: center;
  border: 3px solid var(--accent);
  border-radius: 50%;
  color: var(--accent);
  font-size: 42px;
  font-family: var(--font-title);
}

.popup-heading h2 {
  color: var(--heading);
  font-family: var(--font-title);
  font-size: clamp(25px, 2.5vw, 38px);
  line-height: 1.15;
  margin: 0 0 5px;
}

.popup-heading h2 span { color: var(--accent); }

.more-popup .popup-description {
  margin: 0;
  color: var(--text-pink);
  font-size: 14px;
  line-height: 1.5;
}

.food-search {
  height: 46px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 15px;
  border: 2px solid #f5c4d2;
  border-radius: 30px;
  background: #fffafa;
  color: var(--accent);
}

.food-search span { font-size: 26px; line-height: 1; }
.food-search input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text-dark);
  font: 14px var(--font-main);
}

.popup-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 16px;
}

.popup-categories { display: flex; flex-wrap: wrap; gap: 10px; }
.popup-category {
  border: 0;
  border-radius: 24px;
  padding: 10px 22px;
  background: #fde2e9;
  color: var(--heading);
  font: 600 14px var(--font-main);
  cursor: pointer;
  transition: 0.2s;
}
.popup-category:hover, .popup-category.active {
  background: #ed6687;
  color: #fff;
}

.popup-item-count { white-space: nowrap; font-size: 13px; }
.popup-item-count span { margin-right: 5px; }

.popup-food-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
  padding: 3px 2px 10px;
}

.popup-food-card {
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fffafa;
  border: 1px solid #f7dbe2;
  border-radius: 16px;
  box-shadow: 0 4px 12px rgba(130, 35, 69, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}
.popup-food-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 7px 16px rgba(130, 35, 69, 0.14);
}
.popup-food-card[hidden] { display: none !important; }
.popup-food-card img {
  display: block;
  width: calc(100% - 16px);
  height: 105px;
  margin: 8px 8px 0;
  object-fit: cover;
  border-radius: 12px;
}
.popup-food-info { flex: 1; padding: 9px 10px 7px; }
.popup-food-info h3 {
  color: var(--heading);
  font: 600 14px/1.3 var(--font-main);
  margin: 0 0 4px;
}
.popup-food-info p { color: var(--text-pink); font-size: 14px; font-weight: 700; }
.popup-cart-btn {
  width: calc(100% - 16px);
  margin: 0 8px 9px;
  padding: 8px 5px;
  border: 0;
  border-radius: 22px;
  background: var(--accent);
  color: #fff;
  font: 600 11px var(--font-main);
  cursor: pointer;
}
.popup-cart-btn:hover { background: var(--accent-dark); }
.popup-no-results { padding: 24px 8px; text-align: center; color: var(--heading); }

@media (max-width: 1050px) {
  .popup-heading { grid-template-columns: 60px minmax(0, 1fr); }
  .popup-brand-icon { width: 56px; height: 56px; font-size: 34px; }
  .food-search { grid-column: 2; width: 100%; }
  .popup-food-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .more-popup { width: 94vw; max-width: 94vw; max-height: 90vh; padding: 22px 15px; }
  .popup-heading { grid-template-columns: 1fr; gap: 10px; padding-right: 34px; }
  .popup-brand-icon { display: none; }
  .popup-heading h2 { font-size: 26px; }
  .food-search { grid-column: 1; }
  .popup-toolbar { align-items: flex-start; flex-direction: column; }
  .popup-categories { gap: 7px; }
  .popup-category { padding: 8px 13px; font-size: 12px; }
  .popup-food-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .popup-food-card img { height: 105px; }
}
@media (max-width: 380px) {
  .popup-food-grid { grid-template-columns: 1fr; }
}


/* ====================== FOOD ORDER DETAILS MODAL ====================== */
body.modal-open { overflow: hidden; }
.order-modal {
  /* A manual popover enters the browser top layer, above the food catalog popover. */
  position: fixed;
  inset: 0;
  z-index: 9999;
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 20px;
  border: 0;
  background: transparent;
  color: inherit;
  overflow: visible;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.order-modal.open { display: flex; }
.order-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(61, 22, 37, 0.55);
  backdrop-filter: blur(4px);
}
.order-card {
  position: relative;
  z-index: 1;
  width: min(100%, 470px);
  max-height: 92vh;
  overflow-y: auto;
  padding: 28px;
  border: 1px solid #f5c8d5;
  border-radius: 22px;
  background: #fff8fa;
  color: var(--text-dark);
  box-shadow: 0 18px 55px rgba(70, 15, 36, .28);
  animation: order-pop .18s ease-out;
}
@keyframes order-pop { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
.order-close {
  position: absolute;
  top: 12px;
  right: 14px;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 24px;
  cursor: pointer;
}
.order-eyebrow { margin: 0 35px 5px 0; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }
.order-card h2 { margin: 0 30px 18px 0; color: var(--heading); font-size: 25px; line-height: 1.2; }
.order-product { display: flex; align-items: center; gap: 14px; padding: 12px; margin-bottom: 20px; border-radius: 15px; background: #fde8ee; }
.order-product img { width: 92px; height: 78px; flex: 0 0 92px; object-fit: cover; border-radius: 11px; background: #fff; }
.order-product h3 { margin: 0 0 5px; color: var(--heading); font-size: 17px; }
.order-product p { color: var(--accent); font-size: 14px; font-weight: 700; }
#order-form { display: flex; flex-direction: column; gap: 8px; }
#order-form label { margin-top: 4px; color: var(--heading); font-size: 13px; font-weight: 700; }
#order-form input[type="date"], #order-form input[type="time"] { width: 100%; min-height: 43px; padding: 10px 12px; border: 1px solid #edbdcc; border-radius: 10px; outline-color: var(--accent); background: #fff; color: var(--text-dark); font: 14px var(--font-main); }
.quantity-control { display: grid; grid-template-columns: 44px 1fr 44px; gap: 8px; }
.quantity-control button { border: 0; border-radius: 10px; background: #f8d5e0; color: var(--heading); font-size: 23px; cursor: pointer; }
.quantity-control input { width: 100%; min-height: 42px; border: 1px solid #edbdcc; border-radius: 10px; text-align: center; font: 600 16px var(--font-main); color: var(--text-dark); }
.order-total { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding: 14px 0; border-top: 1px solid #f0cbd6; color: var(--heading); }
.order-total strong { font-size: 22px; }
.confirm-order-btn { width: 100%; padding: 13px 16px; border: 0; border-radius: 24px; background: var(--accent); color: #fff; font: 700 14px var(--font-main); cursor: pointer; transition: .2s; }
.confirm-order-btn:hover { background: var(--accent-dark); }
.order-toast { position: fixed; right: 22px; bottom: 22px; z-index: 10000; max-width: min(420px, calc(100vw - 44px)); padding: 14px 18px; border-radius: 12px; background: #8f2148; color: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.2); font: 14px/1.5 var(--font-main); opacity: 0; transform: translateY(12px); pointer-events: none; transition: .25s; }
.order-toast.show { opacity: 1; transform: translateY(0); }
@media (max-width: 480px) { .order-card { padding: 22px 18px; } .order-card h2 { font-size: 22px; } .order-product img { width: 78px; height: 72px; flex-basis: 78px; } }

/* ====================== IMPROVEMENTS: NAVIGATION + CART ====================== */
.site-header {
  gap: 24px;
  padding: 16px clamp(18px, 4vw, 60px);
}

.site-header nav { margin-left: auto; }
.nav-links { gap: clamp(8px, 1.2vw, 20px); height: auto; }
.nav-links a { white-space: nowrap; }

.header-cart-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 48px;
  padding: 10px 17px;
  border: 0;
  border-bottom: 4px solid var(--text-dark);
  border-radius: 15px;
  background: var(--accent);
  color: #fff;
  font: inherit;
  font-size: 16px;
  cursor: pointer;
  white-space: nowrap;
}

.header-cart-btn:hover { background: var(--accent-hover); }
#cart-count {
  display: inline-grid;
  place-items: center;
  min-width: 22px;
  height: 22px;
  padding: 0 5px;
  border-radius: 50px;
  background: #fff;
  color: var(--accent);
  font: 700 12px Arial, sans-serif;
}

/* Use more of the available width and keep the food sections balanced. */
.container {
  width: 100%;
  max-width: 1440px;
  padding: 28px clamp(18px, 3vw, 42px);
}

.section-title { margin-left: 0; }
.menu-header { margin-left: 0; }
.food-row { gap: 20px; }
.food-card { min-width: 0; }
.cart-btn { user-select: none; }
.cart-btn:focus-visible, .header-cart-btn:focus-visible, .nav-links a:focus-visible {
  outline: 3px solid #6f1838;
  outline-offset: 3px;
}

/* Main menu category buttons */
button.tab {
  border: 0;
  font-family: var(--font-serif);
}

/* Cart panel appears in the browser top layer, above the page and other popups. */
.cart-modal {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 20px;
  border: 0;
  background: rgba(74, 44, 54, 0.45);
  color: var(--text-pink);
  overflow: auto;
}
.cart-modal::backdrop { background: rgba(74, 44, 54, 0.45); backdrop-filter: blur(3px); }
.cart-card {
  position: relative;
  width: min(640px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  margin: 0 auto;
  padding: 30px;
  border-radius: 22px;
  background: #fff7f8;
  box-shadow: 0 16px 45px rgba(65, 15, 35, .28);
}
.cart-card h2 { color: var(--heading); margin: 4px 40px 20px 0; }
.cart-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 24px;
  cursor: pointer;
}
.cart-items { display: grid; gap: 12px; }
.cart-empty { padding: 25px 12px; text-align: center; color: #8b5265; }
.cart-item {
  display: grid;
  grid-template-columns: 82px minmax(0, 1fr);
  gap: 14px;
  padding: 12px;
  border: 1px solid #f2c4d2;
  border-radius: 14px;
  background: #fff;
}
.cart-item > img { width: 82px; height: 82px; border-radius: 10px; object-fit: cover; }
.cart-item-details { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
.cart-item-details strong { color: var(--heading); }
.cart-item-details p { font-size: 12px; line-height: 1.4; overflow-wrap: anywhere; }
.cart-item-subtotal { margin-top: 3px; }
.remove-cart-item { border: 0; background: transparent; color: #a12650; text-decoration: underline; cursor: pointer; padding: 2px 0; }
.cart-summary { display: flex; justify-content: space-between; align-items: center; margin: 20px 0 14px; padding-top: 15px; border-top: 1px solid #efc4d1; font-size: 18px; }
.cart-summary strong { color: var(--heading); }
.cart-card .confirm-order-btn { width: 100%; }

/* Make sure the order modal remains above the food catalog and can scroll on small screens. */
.order-modal {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 20px;
  border: 0;
  background: rgba(74, 44, 54, .48);
  overflow: auto;
}
.order-modal::backdrop { background: rgba(74, 44, 54, .48); backdrop-filter: blur(3px); }

@media (max-width: 1000px) {
  .site-header { flex-wrap: wrap; }
  .nav-links { flex-wrap: wrap; justify-content: flex-end; }
  .nav-links a { padding-left: 13px; padding-right: 13px; }
}

@media (max-width: 600px) {
  .site-header { justify-content: center; padding: 15px; }
  .site-header nav { width: 100%; margin: 0; }
  .nav-links { justify-content: center; gap: 8px; }
  .nav-links a, .header-cart-btn { min-height: 40px; height: auto; padding: 8px 10px; font-size: 12px; }
  .container { padding: 20px 16px; }
  .cart-card { padding: 24px 18px; }
  .cart-item { grid-template-columns: 64px minmax(0, 1fr); }
  .cart-item > img { width: 64px; height: 64px; }
}


/* ABOUT US STRIP */
.about-strip {
    width: 100%;
    max-width: 1200px;
    min-height: 215px;
    margin: 25px auto;
    padding: 15px 25px;

    display: grid;
    grid-template-columns: 1.05fr 1.35fr 1fr;
    align-items: center;
    gap: 25px;

    background: #FFF0F4;
    color: #87364F;
    box-sizing: border-box;
}

/* LEFT FOOD PHOTO */
.about-photo {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.about-photo img {
    width: 70%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
}

.photo-caption {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;

    color: #B8325A;
    font-size: 13px;
    font-weight: bold;
    font-style: italic;
    text-align: center;
}

/* MIDDLE ABOUT DESCRIPTION */
.about-description {
    height: 100%;
    padding: 0 20px;
    border-right: 1px solid #F3C9D5;
    border-left: 1px solid #F3C9D5;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.about-heading {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 12px;
}

.about-heart {
    width: 48px;
    height: 48px;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid #D94F7A;
    border-radius: 50%;
    color: #D94F7A;
    font-size: 32px;
}

.about-heading h2 {
    margin: 0;
    color: #B8325A;
    font-size: 28px;
    font-weight: bold;
    font-style: italic;
}

.about-description > p {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.7;
}

.about-description .about-tagline {
    margin: 5px 0 0;
    color: #B8325A;
    font-size: 14px;
    font-weight: bold;
    font-style: italic;
}

/* RIGHT SERVICE FEATURES */
.about-services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    text-align: center;
}

.about-service {
    padding: 12px 3px;
}

.service-icon {
    width: 55px;
    height: 55px;
    margin: 0 auto 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background: #FBD8E3;
    color: #B8325A;
    font-size: 25px;
}

.about-service h3 {
    margin: 0 0 5px;
    color: #87364F;
    font-size: 14px;
}

.about-service p {
    margin: 0;
    color: #87364F;
    font-size: 12px;
    line-height: 1.5;
}

/* TABLET */
@media (max-width: 900px) {
    .about-strip {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .about-photo {
        height: 190px;
    }

    .about-description {
        border-right: none;
    }

    .about-services {
        grid-column: 1 / -1;
        border-top: 1px solid #F3C9D5;
        padding-top: 10px;
    }
}

/* MOBILE */
@media (max-width: 550px) {
    .about-strip {
        grid-template-columns: 1fr;
        padding: 20px;
        margin: 15px auto;
    }

    .about-photo {
        height: 190px;
    }

    .about-description {
        padding: 20px 0;
        border-left: none;
        border-top: 1px solid #F3C9D5;
        border-bottom: 1px solid #F3C9D5;
    }

    .about-heading h2 {
        font-size: 25px;
    }

    .about-services {
        grid-column: auto;
        gap: 5px;
    }

    .about-service h3 {
        font-size: 12px;
    }

    .about-service p {
        font-size: 11px;
    }
}


