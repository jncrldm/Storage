    <script>
      // Food catalog search and category filters
      const foodSearchInput = document.getElementById('food-search-input');
      const foodCategoryButtons = document.querySelectorAll('.popup-category');
      const popupFoodCards = document.querySelectorAll('.popup-food-card');
      const foodItemCount = document.getElementById('food-item-count');
      const noFoodResults = document.getElementById('popup-no-results');
      let selectedFoodCategory = 'All';

      function filterPopupFoods() {
        const searchTerm = foodSearchInput.value.trim().toLowerCase();
        let visibleCount = 0;
        popupFoodCards.forEach(card => {
          const matchesName = card.dataset.name.includes(searchTerm);
          const matchesCategory = selectedFoodCategory === 'All' || card.dataset.category === selectedFoodCategory;
          const showCard = matchesName && matchesCategory;
          card.hidden = !showCard;
          if (showCard) visibleCount++;
        });
        foodItemCount.textContent = visibleCount;
        noFoodResults.hidden = visibleCount !== 0;
      }
      foodSearchInput.addEventListener('input', filterPopupFoods);
      foodCategoryButtons.forEach(button => {
        button.addEventListener('click', () => {
          selectedFoodCategory = button.dataset.category;
          foodCategoryButtons.forEach(item => item.classList.toggle('active', item === button));
          filterPopupFoods();
        });
      });

      // Order details modal: choose servings and preferred delivery date/time
      const orderModal = document.getElementById('order-modal');
      const orderForm = document.getElementById('order-form');
      const quantityInput = document.getElementById('order-quantity');
      const orderName = document.getElementById('order-food-name');
      const orderPrice = document.getElementById('order-food-price');
      const orderImage = document.getElementById('order-food-image');
      const totalPrice = document.getElementById('order-total-price');
      const toast = document.getElementById('order-toast');
      let selectedProductPrice = 65;
      let selectedProduct = '';
      let selectedImage = '';
      const orderCart = [];
      const cartModal = document.getElementById('cart-modal');
      const cartItemsContainer = document.getElementById('cart-items');
      const cartCount = document.getElementById('cart-count');
      const cartGrandTotal = document.getElementById('cart-grand-total');

      function renderCart() {
        const totalItems = orderCart.reduce((sum, item) => sum + item.quantity, 0);
        cartCount.textContent = totalItems;
        cartItemsContainer.innerHTML = '';
        if (orderCart.length === 0) {
          cartItemsContainer.innerHTML = '<p class="cart-empty">Your cart is empty. Add your favorite food!</p>';
        } else {
          orderCart.forEach((item, index) => {
            const row = document.createElement('div');
            row.className = 'cart-item';
            const image = document.createElement('img');
            image.src = item.image;
            image.alt = item.food;
            const details = document.createElement('div');
            details.className = 'cart-item-details';
            const title = document.createElement('strong');
            title.textContent = item.food;
            const info = document.createElement('p');
            info.textContent = `${item.quantity} serving(s) × ₱${item.price} · Delivery: ${item.deliveryDate} at ${item.deliveryTime}`;
            const subtotal = document.createElement('strong');
            subtotal.className = 'cart-item-subtotal';
            subtotal.textContent = '₱' + (item.quantity * item.price).toLocaleString('en-PH');
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'remove-cart-item';
            remove.textContent = 'Remove';
            remove.addEventListener('click', () => { orderCart.splice(index, 1); renderCart(); });
            details.append(title, info, subtotal, remove);
            row.append(image, details);
            cartItemsContainer.appendChild(row);
          });
        }
        const grandTotal = orderCart.reduce((sum, item) => sum + item.price * item.quantity, 0);
        cartGrandTotal.textContent = '₱' + grandTotal.toLocaleString('en-PH');
      }

      function openCart() {
        renderCart();
        if (!cartModal.matches(':popover-open')) cartModal.showPopover();
        cartModal.setAttribute('aria-hidden', 'false');
      }
      function closeCart() {
        if (cartModal.matches(':popover-open')) cartModal.hidePopover();
        cartModal.setAttribute('aria-hidden', 'true');
      }
      document.getElementById('open-cart').addEventListener('click', openCart);
      document.getElementById('close-cart').addEventListener('click', closeCart);
      const confirmationModal = document.getElementById('order-confirmation-modal');
      const confirmationItems = document.getElementById('confirmation-items');
      const confirmationTotal = document.getElementById('confirmation-total');
      const confirmationReference = document.getElementById('confirmation-reference');

      function closeConfirmation() {
        if (confirmationModal.matches(':popover-open')) confirmationModal.hidePopover();
        confirmationModal.setAttribute('aria-hidden', 'true');
      }

      document.getElementById('close-confirmation').addEventListener('click', closeConfirmation);
      document.getElementById('checkout-cart').addEventListener('click', () => {
        if (orderCart.length === 0) {
          cartItemsContainer.innerHTML = '<p class="cart-empty">Your cart is empty. Add a food item first.</p>';
          return;
        }

        // Save a snapshot of the cart for the confirmation screen before clearing it.
        const confirmedItems = orderCart.map(item => ({ ...item }));
        const confirmedTotal = confirmedItems.reduce((sum, item) => sum + item.price * item.quantity, 0);
        confirmationItems.innerHTML = '';

        confirmedItems.forEach(item => {
          const row = document.createElement('div');
          row.className = 'confirmation-item';
          const name = document.createElement('strong');
          name.textContent = `${item.food} × ${item.quantity}`;
          const schedule = document.createElement('span');
          schedule.textContent = `Delivery: ${item.deliveryDate} at ${item.deliveryTime}`;
          const subtotal = document.createElement('strong');
          subtotal.textContent = '₱' + (item.price * item.quantity).toLocaleString('en-PH');
          row.append(name, schedule, subtotal);
          confirmationItems.appendChild(row);
        });

        confirmationTotal.textContent = '₱' + confirmedTotal.toLocaleString('en-PH');
        confirmationReference.textContent = 'Order reference: CHF-' + Date.now().toString().slice(-8);
        orderCart.length = 0;
        renderCart();
        closeCart();
        if (!confirmationModal.matches(':popover-open')) confirmationModal.showPopover();
        confirmationModal.setAttribute('aria-hidden', 'false');
      });

      function updateOrderTotal() {
        let quantity = Number.parseInt(quantityInput.value, 10);
        if (!Number.isFinite(quantity) || quantity < 1) quantity = 1;
        if (quantity > 99) quantity = 99;
        quantityInput.value = quantity;
        totalPrice.textContent = '₱' + (selectedProductPrice * quantity).toLocaleString('en-PH');
      }

      function openOrderModal(card) {
        const nameElement = card.querySelector('.food-name, .popup-food-info h3');
        const priceElement = card.querySelector('.price, .popup-food-info p');
        const imageElement = card.querySelector('img');
        selectedProduct = nameElement.textContent.trim();
        selectedImage = imageElement.getAttribute('src');
        selectedProductPrice = Number(priceElement.textContent.replace(/[^0-9.]/g, '')) || 65;
        orderName.textContent = selectedProduct;
        orderPrice.textContent = '₱' + selectedProductPrice.toLocaleString('en-PH') + ' per serving';
        orderImage.src = selectedImage;
        orderImage.alt = selectedProduct;
        quantityInput.value = 1;
        const today = new Date();
        const localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        document.getElementById('delivery-date').min = localToday;
        document.getElementById('delivery-date').value = localToday;
        document.getElementById('delivery-time').value = '12:00';
        updateOrderTotal();
        // Show the order form in the browser's top layer, above the food catalog pop-up.
        if (!orderModal.matches(':popover-open')) orderModal.showPopover();
        orderModal.classList.add('open');
        orderModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      }

      function closeOrderModal() {
        orderModal.classList.remove('open');
        if (orderModal.matches(':popover-open')) orderModal.hidePopover();
        orderModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      }

      document.querySelectorAll('.popup-cart-btn').forEach(button => {
        button.addEventListener('click', () => openOrderModal(button.closest('.popup-food-card')));
      });
      document.querySelectorAll('.cart-btn').forEach(button => {
        button.setAttribute('role', 'button');
        button.setAttribute('tabindex', '0');
        button.addEventListener('click', () => openOrderModal(button.closest('.food-card')));
        button.addEventListener('keydown', event => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openOrderModal(button.closest('.food-card'));
          }
        });
      });
      document.querySelectorAll('[data-close-order]').forEach(button => button.addEventListener('click', closeOrderModal));
      document.getElementById('quantity-minus').addEventListener('click', () => {
        quantityInput.value = Math.max(1, (Number.parseInt(quantityInput.value, 10) || 1) - 1);
        updateOrderTotal();
      });
      document.getElementById('quantity-plus').addEventListener('click', () => {
        quantityInput.value = Math.min(99, (Number.parseInt(quantityInput.value, 10) || 1) + 1);
        updateOrderTotal();
      });
      quantityInput.addEventListener('input', updateOrderTotal);
      document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeOrderModal(); closeCart(); closeRequest(); closeConfirmation(); } });

      // Main menu category tabs: show only products assigned to the selected category.
      document.querySelectorAll('[data-menu-category]').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('[data-menu-category]').forEach(item => item.classList.toggle('active', item === tab));
          const category = tab.dataset.menuCategory;
          document.querySelectorAll('[data-menu-item]').forEach(card => {
            card.hidden = card.dataset.category !== category;
          });
        });
      });
      document.querySelector('[data-menu-category].active')?.click();

      orderForm.addEventListener('submit', event => {
        event.preventDefault();
        const quantity = Number.parseInt(quantityInput.value, 10);
        const deliveryDate = document.getElementById('delivery-date').value;
        const deliveryTime = document.getElementById('delivery-time').value;
        orderCart.push({ food: selectedProduct, price: selectedProductPrice, quantity, deliveryDate, deliveryTime, image: selectedImage });
        renderCart();
        closeOrderModal();
        toast.textContent = `${quantity} serving(s) of ${selectedProduct} added to cart.`;
        toast.classList.add('show');
        window.setTimeout(() => toast.classList.remove('show'), 4500);
        console.log('Current order cart:', orderCart);
      });

      // Request form popup (keeps visitors on the website instead of opening email).
      const requestModal = document.getElementById('request-modal');
      function openRequest() {
        if (!requestModal.matches(':popover-open')) requestModal.showPopover();
        requestModal.setAttribute('aria-hidden', 'false');
      }
      function closeRequest() {
        if (requestModal.matches(':popover-open')) requestModal.hidePopover();
        requestModal.setAttribute('aria-hidden', 'true');
      }
      document.getElementById('open-request').addEventListener('click', openRequest);
      document.getElementById('close-request').addEventListener('click', closeRequest);
      document.getElementById('footer-request-link').addEventListener('click', event => { event.preventDefault(); openRequest(); });
      document.getElementById('request-form').addEventListener('submit', event => {
        event.preventDefault();
        const customer = document.getElementById('request-name').value.trim();
        alert(`Thank you, ${customer}! Your request has been recorded for this demo. Please contact the business directly to confirm it.`);
        event.currentTarget.reset();
        closeRequest();
      });
    </script>

